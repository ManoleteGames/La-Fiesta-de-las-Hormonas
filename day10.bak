                     EndGameExtinguisher();

			      		break;
     					case 2: // NO ABRIR EXTINTOR
         				Speech("SPRFACE1.DAT","playerf.pcx","D10_STR.DAT","D10GLB.TXT","015",0,0,0);
      					break;
               }
