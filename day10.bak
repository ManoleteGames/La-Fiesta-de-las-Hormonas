            if(player.hotspot == 7){ // boys bathroom
               Speech("SPRFACE1.DAT","playerf.pcx","D10_STR.DAT","D10GLB.TXT","073","074",0,0);
               Speech("SPRFACE1.DAT","playerf.pcx","D10_STR.DAT","D10GLB.TXT","075","076",0,0);
