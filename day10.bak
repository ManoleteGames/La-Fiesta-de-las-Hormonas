                     DrawSpriteDestructive(9);
                     Update(0);
                     Delay(20);
                     sprite[9].pos_x = sprite[player.spriteNum].pos_x - 8;
                     sprite[9].pos_y = sprite[player.spriteNum].pos_y - 10;
                     DrawSpriteDestructive(9);
