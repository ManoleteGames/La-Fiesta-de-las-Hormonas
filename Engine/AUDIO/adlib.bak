/***********************
*  Adlib functions
************************/

#include "source\engine\engine.h"

/////////////////////////////////////////////////////////
// OPL2 Out
/////////////////////////////////////////////////////////
void OPL2_Out(unsigned char reg, unsigned char data){
	asm mov dx, ADLIB_PORT //00388h
	asm mov al, reg
	asm out dx, al

	//Wait at least 3.3 microseconds
	asm mov cx,6
	wait:
		asm in ax,dx
		asm loop wait	//for (i = 0; i < 6; i++) inp(lpt_ctrl);

	asm inc dx
	asm mov al, data
	asm out dx, al

	//for( i = 35; i ; i-- )inport(0x388);
}

/////////////////////////////////////////////////////////
// OPL2 Clear
/////////////////////////////////////////////////////////
void OPL2_Clear(void){
	int i;
    for (i=1; i< 256; OPL2_Out(i++, 0));    //clear all registers
}


/////////////////////////////////////////////////////////
// Check if Adlib sound card is present
// - returns: 0: No card; 1: Card detected
/////////////////////////////////////////////////////////
byte ADLIB_Present(void){
	byte status1, status2;

    OPL2_Out(4, 0x60);
    OPL2_Out(4, 0x80);

	 asm mov dx,ADLIB_PORT
	 asm in al,dx
    asm mov status1,al;

    OPL2_Out(2, 0xFF);
    OPL2_Out(4, 0x21);
	
	 asm mov dx,ADLIB_PORT
    asm mov cx,100
	 _loop:
		asm in al,dx
		asm loop _loop

	 asm in al,dx
    asm mov status2,al;

    OPL2_Out(4, 0x60);
    OPL2_Out(4, 0x80);
    if ( ( ( status1 & 0xe0 ) == 0x00 ) && ( ( status2 & 0xe0 ) == 0xc0 ) ){
        unsigned char i;
		for (i=1; i<=0xF5; OPL2_Out(i++, 0));    //clear all registers
		OPL2_Out(1, 0x20);  // Set WSE=1
		//_printf("AdLib card detected.\n\r$");
      return 1;
    } else {
		//_printf("AdLib card not detected.\n\r$");
      return 0;
    }
}

