#define K_ESC				0x01
#define K_BKSP				0x0E
#define K_ENTER			0x1C
#define K_O					0x18
#define K_P					0x19
#define K_Q					0x10
#define K_A					0x1E
#define K_S					0x1F
#define K_D					0x20
#define K_UP				0x48
#define K_DOWN				0x50
#define K_LEFT				0x4B
#define K_RIGHT			0x4D
#define K_SPACE			0x39

#define KEYB_IRQ        9
