/***********************
*  SENSEI CONVERSATIONS
************************/

#include "source\engine\engine.h"

void far Sensei(void){
	byte option = 1;
	byte end_conversation = 0;

	switch(player.day){
   	case 4: /////////////////////////// day 4 //////////////////////////////////
      	switch(player.scn_sensei){
         	case 0:
      			Speech("SPRFACE1.DAT","playerf.pcx","D4_STR.DAT","D4GYM.TXT","001",0,0,0);
         		Speech("SPRFACE2.DAT","senseif.pcx","D4_STR.DAT","D4GYM.TXT","002",0,0,0);

         		end_conversation = 0;
         		while(!end_conversation){
   					option = SpeechSelection(3,"SPRFACE1.DAT","playerf.pcx","D4_STR.DAT","D4GYM.TXT","005","006","007",0);
   					switch(option){
							case 1: // are you from japan?
               			Speech("SPRFACE2.DAT","senseif.pcx","D4_STR.DAT","D4GYM.TXT","010","011","012","013");
                  		Speech("SPRFACE1.DAT","playerf.pcx","D4_STR.DAT","D4GYM.TXT","015",0,0,0);
                 			break;
               		case 2: // ask about party
            				Speech("SPRFACE2.DAT","senseif.pcx","D4_STR.DAT","D4GYM.TXT","018","019","020",0);
                  		break;
               		case 3: // byte
               			Speech("SPRFACE2.DAT","senseif.pcx","D4_STR.DAT","D4GYM.TXT","022",0,0,0);
                  		end_conversation = 1;
                  		break;
            		}
         		}
         		SetSpriteAnimation(player.spriteNum,0,6,8,PlayerAnimation);   // Stand up player
         		Update(0);
         		Speech("SPRFACE1.DAT","playerf.pcx","D4_STR.DAT","D4GYM.TXT","025","026","027",0);
         		Speech("SPRFACE2.DAT","senseif.pcx","D4_STR.DAT","D4GYM.TXT","030",0,0,0);
         		SetSpriteAnimation(player.spriteNum,25,1,8,PlayerAnimation); // Set animation >> up
               Update(0);
               Speech("SPRFACE1.DAT","playerf.pcx","D4_STR.DAT","D4GYM.TXT","035",0,0,0);
               break;
            case 99:
               Speech("SPRFACE2.DAT","senseif.pcx","D4_STR.DAT","D4GYM.TXT","040",0,0,0);
               Speech("SPRFACE1.DAT","playerf.pcx","D4_STR.DAT","D4GYM.TXT","045","046","047",0);
               Speech("SPRFACE2.DAT","senseif.pcx","D4_STR.DAT","D4GYM.TXT","050",0,0,0);
            	break;
            default:
            	break;
         }
         break;
      case 3:  /////////////////////////// day 3 //////////////////////////////////
   		switch(player.scn_sensei){
         	case 0:
      			Speech("SPRFACE1.DAT","playerf.pcx","D3_STR.DAT","D3GYM.TXT","001",0,0,0);
         		Speech("SPRFACE2.DAT","senseif.pcx","D3_STR.DAT","D3GYM.TXT","002",0,0,0);

         		end_conversation = 0;
         		while(!end_conversation){
   					option = SpeechSelection(3,"SPRFACE1.DAT","playerf.pcx","D3_STR.DAT","D3GYM.TXT","005","006","007",0);
   					switch(option){
							case 1: // do not get boring?
                     	Speech("SPRFACE1.DAT","playerf.pcx","D3_STR.DAT","D3GYM.TXT","010","011","012",0);
               			Speech("SPRFACE2.DAT","senseif.pcx","D3_STR.DAT","D3GYM.TXT","015","016","017",0);
                        Speech("SPRFACE2.DAT","senseif.pcx","D3_STR.DAT","D3GYM.TXT","020","021","022","023");
                  		Speech("SPRFACE1.DAT","playerf.pcx","D3_STR.DAT","D3GYM.TXT","025","026",0,0);
                        Speech("SPRFACE2.DAT","senseif.pcx","D3_STR.DAT","D3GYM.TXT","030","031","032","033");
                 			break;
               		case 2: // decoration?
            				Speech("SPRFACE2.DAT","senseif.pcx","D3_STR.DAT","D3GYM.TXT","035","036","037",0);
                  		break;
               		case 3: // byte
               			Speech("SPRFACE2.DAT","senseif.pcx","D3_STR.DAT","D3GYM.TXT","040",0,0,0);
                        Speech("SPRFACE1.DAT","playerf.pcx","D3_STR.DAT","D3GYM.TXT","043","044","045",0);
                        Speech("SPRFACE2.DAT","senseif.pcx","D3_STR.DAT","D3GYM.TXT","048","049",0,0);
                  		end_conversation = 1;
                  		break;
            		}
         		}
               break;
            case 99:
               Speech("SPRFACE2.DAT","senseif.pcx","D3_STR.DAT","D3GYM.TXT","055","056","057","058");
               Speech("SPRFACE1.DAT","playerf.pcx","D3_STR.DAT","D3GYM.TXT","060","061","062",0);
               Speech("SPRFACE2.DAT","senseif.pcx","D3_STR.DAT","D3GYM.TXT","065",0,0,0);
            	break;
            default:
            	break;
         }
         break;
      case 2: /////////////////////////// day 2 //////////////////////////////////
      	switch(player.scn_sensei){
         	case 0:
      			Speech("SPRFACE1.DAT","playerf.pcx","D2_STR.DAT","D2GYM.TXT","001",0,0,0);
         		Speech("SPRFACE2.DAT","senseif.pcx","D2_STR.DAT","D2GYM.TXT","002",0,0,0);

         		end_conversation = 0;
         		while(!end_conversation){
   					option = SpeechSelection(3,"SPRFACE1.DAT","playerf.pcx","D2_STR.DAT","D2GYM.TXT","005","006","007",0);
   					switch(option){
							case 1: // operation dragon
                     	Speech("SPRFACE1.DAT","playerf.pcx","D2_STR.DAT","D2GYM.TXT","010","011","012",0);
               			Speech("SPRFACE2.DAT","senseif.pcx","D2_STR.DAT","D2GYM.TXT","015","016","017",0);
                 			break;
               		case 2: // decoration?
                     	Speech("SPRFACE2.DAT","senseif.pcx","D2_STR.DAT","D2GYM.TXT","020","021","022","023");
                  		break;
               		case 3: // bye
               			Speech("SPRFACE2.DAT","senseif.pcx","D2_STR.DAT","D2GYM.TXT","025",0,0,0);
                  		end_conversation = 1;
                  		break;
            		}
         		}
               break;
            case 99:
               Speech("SPRFACE2.DAT","senseif.pcx","D2_STR.DAT","D2GYM.TXT","030","031","032","033");
               Speech("SPRFACE2.DAT","senseif.pcx","D2_STR.DAT","D2GYM.TXT","035","036",0,0);
               Speech("SPRFACE1.DAT","playerf.pcx","D2_STR.DAT","D2GYM.TXT","038","039",0,0);
               Speech("SPRFACE2.DAT","senseif.pcx","D2_STR.DAT","D2GYM.TXT","041","042","043","044");
            	break;
            default:
            	break;
         }
         break;
      case 1:  /////////////////////////// day 1 //////////////////////////////////
      	switch(player.scn_sensei){
         	case 0:
      			Speech("SPRFACE1.DAT","playerf.pcx","D1_STR.DAT","D1GYM.TXT","001",0,0,0);
         		Speech("SPRFACE2.DAT","senseif.pcx","D1_STR.DAT","D1GYM.TXT","002",0,0,0);

         		end_conversation = 0;
         		while(!end_conversation){
   					option = SpeechSelection(3,"SPRFACE1.DAT","playerf.pcx","D1_STR.DAT","D1GYM.TXT","005","006","007",0);
   					switch(option){
							case 1: // speak japanesse?
                     	Speech("SPRFACE1.DAT","playerf.pcx","D1_STR.DAT","D1GYM.TXT","010","011","012",0);
               			Speech("SPRFACE2.DAT","senseif.pcx","D1_STR.DAT","D1GYM.TXT","015","016","017",0);
                 			break;
               		case 2: // decoration?
                     	Speech("SPRFACE2.DAT","senseif.pcx","D1_STR.DAT","D1GYM.TXT","020","021","022","023");
                  		break;
               		case 3: // bye
               			Speech("SPRFACE2.DAT","senseif.pcx","D1_STR.DAT","D1GYM.TXT","025",0,0,0);
                  		end_conversation = 1;
                  		break;
            		}
         		}
               break;
            case 99:
               Speech("SPRFACE2.DAT","senseif.pcx","D1_STR.DAT","D1GYM.TXT","030","031","032","033");
               Speech("SPRFACE2.DAT","senseif.pcx","D1_STR.DAT","D1GYM.TXT","035","036",0,0);
               Speech("SPRFACE1.DAT","playerf.pcx","D1_STR.DAT","D1GYM.TXT","038","039",0,0);
               Speech("SPRFACE2.DAT","senseif.pcx","D1_STR.DAT","D1GYM.TXT","041","042","043","044");
            	break;
            default:
            	break;
         }
         break;
   }
}
